      "message": "I believe this plugin can also be totally rewritten with a single Groovy file:\n\n```\n/**\n *****************************************************************************\n * Copyright (c) 2013, 2025 Eclipse Foundation and others. All rights reserved.\n * This program and the accompanying materials are made available under the\n * terms of the Eclipse Public License v1.0 which accompanies this distribution,\n * and is available at http://www.eclipse.org/legal/epl-v10.html\n *\n * Contributors: Wayne Beaton (Eclipse Foundation)- initial API and implementation\n *****************************************************************************\n */\npackage org.eclipse.foundation.gerrit.validation\n\nimport com.google.common.flogger.FluentLogger\nimport com.google.gerrit.entities.Project\nimport com.google.gerrit.extensions.annotations.PluginName\nimport com.google.gerrit.server.config.PluginConfigFactory\nimport com.google.gerrit.server.events.CommitReceivedEvent\nimport com.google.gerrit.server.git.validators.CommitValidationException\nimport com.google.gerrit.server.git.validators.CommitValidationListener\nimport com.google.gerrit.server.git.validators.CommitValidationMessage\nimport com.google.gerrit.server.project.NoSuchProjectException\nimport com.google.gerrit.server.project.ProjectCache\nimport com.google.inject.Inject\nimport com.google.inject.Singleton\nimport groovy.json.JsonException\nimport groovy.json.JsonOutput\nimport groovy.json.JsonSlurper\nimport org.eclipse.jgit.lib.PersonIdent\nimport org.eclipse.jgit.revwalk.RevCommit\n\n/**\n * The EclipseCommitValidationListener implements CommitValidationListener to ensure that project\n * committer or contributor have a valid ECA at the time of the push.\n *\n * \u003cp\u003eThere more is information regarding ECA requirements and workflow on the \u003ca\n * href\u003d\"http://wiki.eclipse.org/CLA/Implementation_Requirements\"\u003eEclipse Wiki\u003c/a\u003e.\n *\n * \u003cp\u003eThe CommitValidationListener is not defined as part of the extension API, which means that we\n * need to build this as a version-sensitive \u003ca\n * href\u003d\"http://gerrit-documentation.googlecode.com/svn/Documentation/2.6/dev-plugins.html\"\u003eGerrit\n * plugin\u003c/a\u003e.\n */\n@Singleton\nclass EclipseCommitValidationListener implements CommitValidationListener {\n\n    private static final FluentLogger logger \u003d FluentLogger.forEnclosingClass()\n    private static final String ECA_DOCUMENTATION \u003d \"Please see http://wiki.eclipse.org/ECA\"\n    private static final int DEFAULT_API_TIMEOUT_SECS \u003d 20\n    private static final String ECA_VALIDATION_URL \u003d \"https://api.eclipse.org/git/eca\"\n\n    private final ProjectCache projectCache\n    private final String pluginName\n    private final PluginConfigFactory pluginCfgFactory\n\n    @Inject\n    EclipseCommitValidationListener(\n            @PluginName String pluginName,\n            ProjectCache projectCache,\n            PluginConfigFactory pluginCfgFactory) {\n        this.pluginName \u003d pluginName\n        this.projectCache \u003d projectCache\n        this.pluginCfgFactory \u003d pluginCfgFactory\n    }\n\n    /**\n     * Validate a single commit (this listener will be invoked for each commit in a push operation).\n     */\n    @Override\n    List\u003cCommitValidationMessage\u003e onCommitReceived(CommitReceivedEvent receiveEvent) throws CommitValidationException {\n        def messages \u003d []\n        def errors \u003d []\n        def project \u003d receiveEvent.project.nameKey\n\n        if (!isEnabledForProject(project)) {\n            logger.atFine().log(\"Plugin %s is not enabled for project %s: Skip validation\", pluginName, project.get())\n            return messages\n        }\n\n        def commit \u003d receiveEvent.commit\n        def authorIdent \u003d commit.authorIdent\n\n        addSeparatorLine(messages)\n        messages \u003c\u003c new CommitValidationMessage(\"Reviewing commit: ${commit.abbreviate(8).name()}\", false)\n        messages \u003c\u003c new CommitValidationMessage(\"Authored by: ${authorIdent.name} \u003c${authorIdent.emailAddress}\u003e\", false)\n        addEmptyLine(messages)\n\n        def response \u003d validate(project, authorIdent, commit.committerIdent, commit)\n\n        response.commits.values().each { c -\u003e\n            messages.addAll(\n                c.messages.collect { msg -\u003e\n                    new CommitValidationMessage(msg.message, msg.code \u003c 0 \u0026\u0026 response.trackedProject)\n                }\n            )\n            addEmptyLine(messages)\n\n            if (response.errorCount \u003e 0 \u0026\u0026 response.trackedProject) {\n                errors.addAll(c.errors.collect { it.message })\n                errors \u003c\u003c \"An Eclipse Contributor Agreement is required.\"\n            }\n        }\n\n        if (errors) {\n            addDocumentationPointerMessage(messages)\n            throw new CommitValidationException(errors.first(), messages)\n        }\n\n        addSuccessMessage(messages, \"This commit passes Eclipse validation.\")\n    }\n\n    /**\n     * Executes the HTTP validation call against the ECA API natively.\n     */\n    private def validate(Project.NameKey project, PersonIdent authorIdent, PersonIdent committerIdent, RevCommit commit) throws CommitValidationException {\n        def request \u003d new ValidationRequest(\n                project.toString(),\n                [getRequestCommit(commit, authorIdent, committerIdent)],\n                \"gerrit\",\n                true\n        )\n        logger.atFine().log(\"Request object: %s\", request)\n\n        def apiTimeout \u003d DEFAULT_API_TIMEOUT_SECS\n        try {\n            apiTimeout \u003d pluginCfgFactory\n                    .getFromProjectConfigWithInheritance(project, pluginName)\n                    .getInt(\"apiTimeout\", DEFAULT_API_TIMEOUT_SECS)\n        } catch (NoSuchProjectException e) {\n            throw new CommitValidationException(\"No such project\", new CommitValidationMessage(\"Cannot find project $project\", true), e)\n        }\n\n        def deadlineSecs \u003d apiTimeout \u003e 0 ? apiTimeout : DEFAULT_API_TIMEOUT_SECS\n        def timeoutMillis \u003d deadlineSecs * 1000\n\n        try {\n            // Native Groovy HttpURLConnection handling\n            def connection \u003d new URL(ECA_VALIDATION_URL).openConnection() as HttpURLConnection\n            connection.requestMethod \u003d \u0027POST\u0027\n            connection.doOutput \u003d true\n            connection.setRequestProperty(\"Content-Type\", \"application/json\")\n            connection.setRequestProperty(\"Accept\", \"application/json\")\n            connection.connectTimeout \u003d timeoutMillis\n            connection.readTimeout \u003d timeoutMillis\n\n            // Automatically handles the output stream and closes it\n            connection.outputStream.withWriter(\"UTF-8\") { writer -\u003e\n                writer.write(JsonOutput.toJson(request))\n            }\n\n            if (connection.responseCode \u003e\u003d 400) {\n                throw new IOException(\"HTTP ${connection.responseCode}: ${connection.errorStream?.text}\")\n            }\n\n            // Natively parse the JSON directly from the input stream\n            def response \u003d new JsonSlurper().parse(connection.inputStream)\n\n            if (!response?.commits) {\n                throw new CommitValidationException(\"The ECA service returned an incomplete or malformed response, please contact the administrator if this error persists\")\n            }\n            \n            logger.atFine().log(\"Response object: %s\", response)\n            return response\n\n        } catch (java.net.SocketTimeoutException e) {\n            logger.atSevere().withCause(e).log(\"ECA validation timed out after %ss\", deadlineSecs)\n            throw new CommitValidationException(\"Verification of the commit timed out\", new CommitValidationMessage(\"ECA validation timed out after ${deadlineSecs}s\", true), e)\n        } catch (JsonException | IllegalArgumentException e) {\n            logger.atSevere().withCause(e).log(\"%s\", e.message)\n            throw new CommitValidationException(\"An error happened while retrieving validation response, please contact the administrator if this error persists\", e)\n        } catch (Exception e) {\n            logger.atSevere().withCause(e).log(\"%s\", e.message)\n            throw new CommitValidationException(\"An error happened while checking commit\", new CommitValidationMessage(e.message, true), e)\n        }\n    }\n\n    /**\n     * Creates request representation of the commit.\n     */\n    private static Commit getRequestCommit(RevCommit src, PersonIdent author, PersonIdent committer) {\n        def parentHashes \u003d src.parents*.name() ?: []\n        \n        new Commit(\n                src.name(),\n                src.shortMessage,\n                src.fullMessage,\n                parentHashes,\n                new GitUser(author.name, author.emailAddress),\n                new GitUser(committer.name, committer.emailAddress),\n                true\n        )\n    }\n\n    private boolean isEnabledForProject(Project.NameKey project) {\n        def projectState \u003d projectCache.get(project)\n\n        if (!projectState.present) {\n            logger.atSevere().log(\"Failed to check if %s is enabled for project %s: Project not found\", pluginName, project.get())\n            return false\n        }\n\n        \"true\" \u003d\u003d pluginCfgFactory\n                .getFromProjectConfigWithInheritance(projectState.get(), pluginName)\n                .getString(\"enabled\", \"false\")\n    }\n\n    private static List\u003cCommitValidationMessage\u003e addSuccessMessage(List\u003cCommitValidationMessage\u003e messages, String message) {\n        messages \u003c\u003c new CommitValidationMessage(message, false)\n    }\n\n    private static void addSeparatorLine(List\u003cCommitValidationMessage\u003e messages) {\n        messages \u003c\u003c new CommitValidationMessage(\"----------\", false)\n    }\n\n    private static void addEmptyLine(List\u003cCommitValidationMessage\u003e messages) {\n        messages \u003c\u003c new CommitValidationMessage(\"\", false)\n    }\n\n    private static void addDocumentationPointerMessage(List\u003cCommitValidationMessage\u003e messages) {\n        messages \u003c\u003c new CommitValidationMessage(ECA_DOCUMENTATION, false)\n    }\n}\n```",
